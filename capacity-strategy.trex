<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="com.smartmetrix.capacity" extension-version="1.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Campus Capacity &amp; Service Strategy: seats, attendance, and fill % against the new full thresholds (prime 70%, other 40%), with a growth-trigger scorecard and network roll-up.</description>
    <author name="Smart Metrix Data" email="amber@smartmetrixdata.com" organization="Smart Metrix Data" website="https://www.smartmetrixdata.com"/>
    <min-api-version>1.4</min-api-version>
    <source-location>
      <url>https://dashboards.smartmetrixdata.com/index.html</url>
    </source-location>
    <icon>iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+M8AAAMEAYDwppgWAAAAAElFTkSuQmCC</icon>
  </dashboard-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">Campus Capacity &amp; Service Strategy</text>
    </resource>
  </resources>
</manifest>
