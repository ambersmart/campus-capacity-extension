<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="com.smartmetrix.rooted" extension-version="1.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name" />
    <description>Rooted effectiveness dashboard — milestones, lift &amp; durability, and retention for Lakepointe's Rooted program. Binds chart values to live worksheet data via the Tableau Extensions API.</description>
    <author name="SmartMetrix" email="amber@smartmetrixdata.com" organization="Smart Metrix Data" website="https://smartmetrixdata.com" />
    <min-api-version>1.4</min-api-version>
    <source-location>
      <url>https://dashboards.smartmetrixdata.com/rooted/index.html</url>
    </source-location>
    <icon></icon>
  </dashboard-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">Rooted Effectiveness</text>
    </resource>
  </resources>
</manifest>
