<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="com.smartmetrix.goalscorecard" extension-version="1.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Executive goal-metrics scorecard: progress bars, status pills, and a linked detail card with a pace chart.</description>
    <author name="Smart Metrix Data" email="noreply@smartmetrixdata.com" organization="Smart Metrix Data" website="https://www.smartmetrixdata.com"/>
    <min-api-version>1.4</min-api-version>
    <source-location>
      <url>https://dashboards.smartmetrixdata.com/scorecard/index.html</url>
    </source-location>
    <icon>iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+M8AAAMEAYDwppgWAAAAAElFTkSuQmCC</icon>
  </dashboard-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">Goal Metrics — Executive Scorecard</text>
    </resource>
  </resources>
</manifest>
