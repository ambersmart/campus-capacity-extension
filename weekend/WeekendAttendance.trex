<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="com.smartmetrixdata.flatirons.weekendattendance" extension-version="1.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Weekend attendance summary report for Flatirons — totals, campus &amp; service breakdown, and last-weekend / prior-year comparisons.</description>
    <author name="Smart Metrix Data" email="amber@smartmetrixdata.com" organization="Smart Metrix Data" website="https://smartmetrixdata.com"/>
    <min-api-version>1.4</min-api-version>
    <source-location>
      <!-- Hosted on GitHub Pages — works on Tableau Desktop, Server, and Cloud.
           No local server needed. -->
      <url>https://dashboards.smartmetrixdata.com/weekend/index.html</url>
    </source-location>
    <icon>iVBORw0KGgoAAAANSUhEUgAAAEYAAABGCAIAAAD+THXTAAAAfElEQVR42u3asQ2AIBCGUSawt6NiEhd3CRagYA0GMMHGQLy85O+/e/2l3mqwJSQkJCQkJCQkpJ8cel/HZEhISEhISEjxSSWfr0NCQkJCQkJCQtpLmiefYSQkJCQkJCQkpPWkb5NISEhISEhISEhISEhxSB5BkZCQkJA2kAZJwUW2lnmbsgAAAABJRU5ErkJggg==</icon>
  </dashboard-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">Weekend Attendance</text>
    </resource>
  </resources>
</manifest>
