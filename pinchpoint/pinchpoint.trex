<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="com.smartmetrix.pinchpoint" extension-version="1.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Campus Pinchpoint Dashboard: average weekly attendance vs. room capacity, with a weekend stoplight view.</description>
    <author name="Smart Metrix Data" email="noreply@smartmetrixdata.com" organization="Smart Metrix Data" website="https://www.smartmetrixdata.com"/>
    <min-api-version>1.4</min-api-version>
    <source-location>
      <url>https://dashboards.smartmetrixdata.com/pinchpoint/index.html</url>
    </source-location>
    <icon>iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+M8AAAMEAYDwppgWAAAAAElFTkSuQmCC</icon>
  </dashboard-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">Campus Pinchpoint Dashboard</text>
    </resource>
  </resources>
</manifest>
